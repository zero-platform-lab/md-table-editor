{
  "name": "md-table-editor",
  "displayName": "Markdown Table Editor",
  "description": "Edit Markdown tables in a visual grid UI",
  "version": "0.11.6",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdTableEditor.editTable",
        "title": "Edit Table in Grid"
      },
      {
        "command": "mdTableEditor.newTable",
        "title": "New Table"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mdTableEditor.editTable",
          "when": "editorLangId == markdown",
          "group": "1_modification@1"
        },
        {
          "command": "mdTableEditor.newTable",
          "when": "editorLangId == markdown",
          "group": "1_modification@2"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Table Editor",
      "properties": {
        "mdTableEditor.syncMode": {
          "type": "string",
          "enum": ["auto", "manual"],
          "default": "auto",
          "description": "Sync mode: 'auto' syncs on keystroke with debounce, 'manual' requires clicking Apply"
        },
        "mdTableEditor.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 5000,
          "description": "Delay (ms) before syncing cell edits to Markdown"
        }
      }
    },
    "keybindings": [
      {
        "command": "mdTableEditor.editTable",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == markdown"
      },
      {
        "command": "mdTableEditor.newTable",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
